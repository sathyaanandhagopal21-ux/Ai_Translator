# AI Voice Translator - environment variables
#
# The default `auto` backend uses Groq/Gemini when their keys are set and
# falls back to Google/MyMemory when they are absent or unavailable.
# To configure the optional hosted backends:
#   1. Copy this file to  ".env"   (same folder as main.py)
#   2. Paste your key after the "="
#   3. NEVER commit your real .env  (keys are secrets)
#
# config.load_env_file() reads these into the environment at startup.

# Reserved for future provider integrations.
OPENAI_API_KEY=
DEEPL_API_KEY=

# For Google Cloud Translation / Speech (paid, official APIs)
GOOGLE_CLOUD_API_KEY=

# Optional faster speech recognition through Groq-hosted Whisper.
# In the default auto mode, Groq is tried first when this key is present,
# then the existing Google Web Speech backend is used as a fallback.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional Gemini translation backend. Gemini is tried before the existing
# Google/MyMemory translation fallbacks when this key is present.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Backend selection: auto, google, groq (STT); auto, gemini, google, mymemory
# (translation). `auto` is recommended for graceful fallback.
STT_ENGINE=auto
TRANSLATION_ENGINE=auto
